            </emission>
            <ambient>
              <texture texture="posz_jpg-sampler" texcoord="CHANNEL1"/>
            </ambient>
            <diffuse>
              <color>0 0 0 1</color>
            </diffuse>
            <specular>
              <color>0 0 0 1</color>
            </specular>
            <shininess>
              <float>0</float>
            </shininess>
            <reflective>
              <color>0 0 0 1</color>
            </reflective>
            <transparent opaque="A_ONE">
              <color>1 1 1 1</color>
            </transparent>
            <transparency>
              <float>1</float>
            </transparency>
